diff --git a/include/pe1/akao/commands.h b/include/pe1/akao/commands.h
index 9cbd0e4ab..6c9262fe9 100644
--- a/include/pe1/akao/commands.h
+++ b/include/pe1/akao/commands.h
@@ -70,6 +70,31 @@ extern int g_AkaoCmdArg0;
 extern int g_AkaoCmdArg1;
 extern int g_AkaoCmdArg2;
 extern int g_AkaoCmdArg3;
+/* g_AkaoCmdArg0 as the sample load opcodes stage it: a sample header address. */
+extern unsigned short *g_AkaoCmdSampleData;
+
+/* Queue entry as the staged-command executor fills it: the opcode is written
+ * as a full word, followed by the staged arguments. */
+typedef struct AkaoStagedMessage {
+    int opcode;
+    union {
+        int value;
+        unsigned short *sampleData; /* past the sample header */
+    } arg0;
+    int arg1;
+    int arg2;
+    int arg3;
+    int sequence;
+} AkaoStagedMessage;
+
+/* Akao_AllocMessageSlot under the staged-message view of the queue entry. */
+void Akao_AllocStagedMessage(AkaoStagedMessage **out_msg);
+
+
+/* Nonzero while the executor runs. */
+extern int D_8009D268;
+/* Rolling 0x400..0x5FF sequence number handed to opcode 0x24 messages. */
+extern int D_8009CDF0;
 
 int Akao_EnqueueStagedCommand(void);
 
